# Copy to .env and paste your key: https://novita.ai/settings/key-management
NOVITA_API_KEY=
NOVITA_BASE_URL=https://api.novita.ai/openai

# Model ids are configuration, never constants — Novita rotates its catalog and
# the display names on the website are not API ids. If either default 404s at
# startup, list what is actually served:
#
#   uv run python -m dungeon_master.cli --models
#
# Use an INSTRUCT-tuned model for the narrator, never a reasoning one. Reasoning
# models emit their scratchpad as `reasoning_content` and can spend the whole
# token budget before producing a word of prose. Both deepseek-v4-flash and
# ling-3.0-flash were tried and starve; game.log warns by name if it happens.
NARRATOR_MODEL=moonshotai/kimi-k2-instruct

# The extractor is chosen for reliable JSON and cost, not for prose — it never
# writes a sentence anyone reads. Two settings, so either can move alone.
EXTRACTOR_MODEL=meta-llama/llama-3.3-70b-instruct
